{
  "manifest_version": 3,
  "name": "LeetCode Driver",
  "version": "1.1.0",
  "description": "Every new tab shows the problem you owe, and your LeetCode session stays fresh automatically.",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "cookies", "alarms"],
  "host_permissions": ["https://leetcode.com/*"],
  "optional_host_permissions": ["http://localhost/*", "https://*/*"]
}
