{
  "manifest_version": 3,
  "name": "LeetCode Driver",
  "version": "1.3.0",
  "description": "Shows the problem you owe on every new tab, times the attempt on the page, and detects the solve itself.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://neetcode.io/*"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://neetcode.io/*"
      ],
      "js": [
        "overlay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://neetcode.io/problems/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page.js"
      ],
      "matches": [
        "https://leetcode.com/*",
        "https://neetcode.io/*"
      ]
    }
  ],
  "action": {
    "default_title": "Show LeetCode Driver"
  }
}