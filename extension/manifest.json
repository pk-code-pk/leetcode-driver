{
  "manifest_version": 3,
  "name": "LeetCode Driver",
  "version": "1.2.0",
  "description": "Every new tab shows the problem you owe, and solves are detected on the page itself.",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "cookies", "alarms"],
  "host_permissions": ["https://leetcode.com/*", "https://neetcode.io/*"],
  "optional_host_permissions": ["http://localhost/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*", "https://neetcode.io/problems/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page.js"],
      "matches": ["https://leetcode.com/*", "https://neetcode.io/*"]
    }
  ]
}
