# --- required ---------------------------------------------------------------
DATABASE_URL=postgresql://user:pass@host/db     # Supabase / Railway / Neon — any Postgres
SECRET_KEY=                                     # >=16 chars; encrypts the LeetCode cookie at rest
TELEGRAM_BOT_TOKEN=                             # from @BotFather
TELEGRAM_WEBHOOK_SECRET=                        # any random string; Telegram echoes it back
DRIVER_TOKEN=                                   # bearer token for /api/cookie and /api/cron
PUBLIC_URL=https://your-app.up.railway.app      # used to register the Telegram webhook

# --- optional ---------------------------------------------------------------
# OPENAI_API_KEY=                            # hint ladder + auto pattern notes.
#                                               # Without it: hint level 1 still names the
#                                               # topic from local data, levels 2-4 are off,
#                                               # and no pattern notes. Scheduling, sync,
#                                               # grade inference and escalation are unaffected.
# DISABLE_CRON=1                                # for platforms that drive /api/cron externally
